{
  "name": "gym-app-server",
  "version": "1.0.0",
  "private": true,
  "description": "健身器械助手 · 生产级后端（Node.js + Express + SQLite），完全兼容 docs/api.md 接口契约",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "smoke": "bash smoke.sh",
    "test": "bash tests/run-all.sh",
    "test:difftest": "node tests/difftest.js",
    "test:store": "node tests/store-test.js",
    "test:e2e": "node tests/e2e-test.js",
    "test:dom": "node tests/dom-test.js",
    "check:driver": "node scripts/probe-driver.js && echo 'better-sqlite3 可用' || echo 'better-sqlite3 不可用，将回退 node:sqlite'"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  }
}
